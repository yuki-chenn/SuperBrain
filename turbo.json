{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig*.json",
        "package.json",
        "vite.config.ts",
        "nest-cli.json",
        "prisma/schema.prisma",
        "prisma/migrations/**",
        "prisma/seed.ts",
        "prisma/seed/**"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig*.json",
        "package.json",
        "jest.config.ts",
        "vitest.config.ts"
      ]
    },
    "lint": {
      "inputs": [
        "src/**",
        ".eslintrc*",
        "eslint.config.*"
      ]
    }
  }
}
